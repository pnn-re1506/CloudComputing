{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateAndDescribeOwnTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DescribeTable"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-1:<ACCOUNT_ID>:table/FileNotes"
    },
    {
      "Sid": "ReadWriteOwnTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-1:<ACCOUNT_ID>:table/FileNotes"
    }
  ]
}
