<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>edu.cloudcomputing26</groupId>
  <artifactId>s3-get-bucket-name-function</artifactId>
  <name>S3GetBucketName Lambda</name>
  <version>1.0.0</version>
  <description>Replaces s3-v5-webapp's S3GetBucketName servlet. Returns the
    configured bucket name, after checking the caller's token by
    invoking the existing "CheckTokenIsValid" Lambda function (see
    labs/check-token-is-valid-lambda/) directly. Invoked via a Lambda
    Function URL (payload format v2.0) — the "serverless web app"
    session's working example.</description>
  <build>
    <finalName>s3-get-bucket-name-function</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws.sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <aws.sdk.version>2.55.4</aws.sdk.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
</project>
