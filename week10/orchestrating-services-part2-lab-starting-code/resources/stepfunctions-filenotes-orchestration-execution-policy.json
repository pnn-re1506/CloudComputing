{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteFileNotesFromStateMachine",
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:ap-southeast-1:<ACCOUNT_ID>:table/FileNotes"
    },
    {
      "Sid": "DeleteObjectForCompensatingAction",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::<YOUR_BUCKET_NAME>/*"
    }
  ]
}
